# Platform type: eks | k8s
PLATFORM=eks

# EKS Settings (required when PLATFORM=eks)
REGION=us-west-2
EKS_CLUSTER_NAME=genai-on-eks
EKS_MODE=auto
DOMAIN=
HF_TOKEN=
# ---------------------------------------------------------------------------
# Credentials: NO DEFAULTS ON PURPOSE.
#
# These values gate admin UIs and LLM proxy master keys. Shipping a default
# here means every deployment of this public repo shares the same credential,
# so anyone can read it from GitHub and sign in. Leave them EMPTY here and set
# them per deployment in `.env.local` (git-ignored) or `env.workshop`.
#
# Empty is validated: each component calls checkRequiredEnvVars() and exits 1
# when a value is missing, so a deployment fails closed instead of coming up
# with a known password.
#
# Generate a strong unique value per deployment, for example:
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
# ---------------------------------------------------------------------------
# Open WebUI
OPENWEBUI_ADMIN_EMAIL=admin@example.com
OPENWEBUI_ADMIN_PASSWORD=
# LiteLLM
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=
LITELLM_API_KEY=
# Kong
KONG_API_KEY=
KONG_API_KEY_HEADER=apikey
# Kong's bundled PostgreSQL (in-cluster only, still generate per deployment)
KONG_POSTGRES_PASSWORD=
# Langfuse
LANGFUSE_USERNAME=admin@example.com
LANGFUSE_PASSWORD=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Cryptographic secrets - generate per deployment, never share across installs:
#   LANGFUSE_SALT / LANGFUSE_NEXTAUTH_SECRET : openssl rand -base64 32
#   LANGFUSE_ENCRYPTION_KEY                  : openssl rand -hex 32  (must be 64 hex chars)
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_ENCRYPTION_KEY=
# Backing datastores for Langfuse (PostgreSQL / ClickHouse / Valkey).
# In-cluster only, but still generate per deployment: openssl rand -base64 24 | tr -d '/+=' | cut -c1-20
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
# MLflow
MLFLOW_USERNAME=admin
MLFLOW_PASSWORD= # Min 12 characters
MLFLOW_POSTGRES_PASSWORD=
# Grafana (NVIDIA platform monitoring stack)
GRAFANA_ADMIN_PASSWORD=
# Pheonix
PHOENIX_API_KEY=
# Arize AX (SaaS) - alternative stack (feat/kong-arize-strands)
# Use the Arize *Service* API key (ak-..., 72 char), NOT the 40-char user key.
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_OTLP_ENDPOINT=https://otlp.arize.com
# qDrant
QDRANT_USERNAME=admin
QDRANT_PASSWORD=
# Milvus
MILVUS_USERNAME=admin
MILVUS_PASSWORD=
# Guardrails AI
GUARDRAILS_AI_API_KEY=
# OpenClaw
OPENCLAW_DOC_WRITER_GIT_USERNAME=
OPENCLAW_DOC_WRITER_GIT_TOKEN=
